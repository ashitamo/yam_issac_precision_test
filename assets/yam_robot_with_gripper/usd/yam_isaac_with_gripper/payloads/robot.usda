#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "output"
    doc = """Generated from Composed Stage of root layer /tmp/tmpdlml01so/output.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_yam_isaac_with_gripper_41ekijj8/usdex_yam_isaac_with_gripper/output.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_yam_isaac_with_gripper_41ekijj8/temp_yam_isaac_with_gripper/yam_isaac_with_gripper.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "output" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </output/Physics/world_to_base>,
        </output/Physics/joint1>,
        </output/Physics/joint2>,
        </output/Physics/joint3>,
        </output/Physics/joint4>,
        </output/Physics/joint5>,
        </output/Physics/joint6>,
        </output/Physics/joint7>,
        </output/Physics/joint8>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </output/Geometry/world/base>,
        </output/Geometry/world/base/link1>,
        </output/Geometry/world/base/link1/link2>,
        </output/Geometry/world/base/link1/link2/link3>,
        </output/Geometry/world/base/link1/link2/link3/link4>,
        </output/Geometry/world/base/link1/link2/link3/link4/link5>,
        </output/Geometry/world/base/link1/link2/link3/link4/link5/gripper>,
        </output/Geometry/world/base/link1/link2/link3/link4/link5/gripper/tip_left>,
        </output/Geometry/world/base/link1/link2/link3/link4/link5/gripper/tip_right>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "base" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link3" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "link4" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "link5" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "gripper" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "tip_left" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                        }

                                        over "tip_right" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "world_to_base" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint7" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint8" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint6" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

