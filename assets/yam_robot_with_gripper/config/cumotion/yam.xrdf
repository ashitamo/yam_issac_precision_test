format: "xrdf"
format_version: 2.0

default_joint_positions:
  joint1: 0.0114
  joint2: 0.0
  joint3: 0.0
  joint4: -0.2755
  joint5: 0.006
  joint6: 0.7971
  joint7: 0.0

cspace:
  joint_names: ["joint1", "joint2", "joint3", "joint4", "joint5", "joint6"]
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [10000.0, 10000.0, 10000.0, 10000.0, 10000.0, 10000.0]

tool_frames: ["gripper"]

world_collision:
  geometry: "yam_collision_spheres"

self_collision:
  geometry: "yam_collision_spheres"
  ignore:
    base: ["link1"]
    link1: ["link2"]
    link2: ["link3"]
    link3: ["link4"]
    link4: ["link5"]
    link5: ["gripper"]
    gripper: ["tip_left", "tip_right"]
    tip_left: ["tip_right"]

geometry:
  yam_collision_spheres:
    spheres:
      # Generated from URDF collision meshes at 6 mm voxel resolution.
      # Centers are expressed in each link frame; radii include 10% padding.
